{
  "name": "Mikato CRM · Estilistas Caninos",
  "short_name": "Mikato CRM",
  "description": "Agenda, clientes, mascotas, ventas y reportes para estéticas caninas. Datos locales en tu navegador.",
  "lang": "es-MX",
  "dir": "ltr",
  "start_url": "/crm/",
  "scope": "/crm/",
  "id": "/crm/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f5f7fa",
  "theme_color": "#0b2440",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/crm/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/crm/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/crm/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Hoy", "url": "/crm/#/hoy", "icons": [{ "src": "/crm/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Agenda", "url": "/crm/#/agenda", "icons": [{ "src": "/crm/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Ventas", "url": "/crm/#/ventas", "icons": [{ "src": "/crm/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
